# Set securely in your server environment. The example does not load this file.
OBJECTID_PARTNER_ID=YOUR_PARTNER_ID
OBJECTID_PARTNER_SECRET=YOUR_SECRET
OBJECTID_RECIPIENT=0xYOUR_APPROVED_64_HEX_CHARACTER_ADDRESS
OBJECTID_REQUEST_ID=YOUR_STABLE_BUSINESS_REQUEST_ID
OBJECTID_CREDIT_AMOUNT=1

# Safe default. Mainnet also requires an approved mainnet contract/signing policy.
OBJECTID_NETWORK=testnet
# Set true only for an explicitly intended CLI mainnet request.
OBJECTID_ALLOW_MAINNET_REQUEST=false
